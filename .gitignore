# ==============================
# CareMate - Git Ignore
# ==============================

# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE / editor
.vscode/
.idea/
*.code-workspace

# Logs
*.log
logs/

# Runtime / temporary data
data/
temp/
tmp/
*.tmp
*.cache
dashboard/dhost.db

# Generated audio
*.mp3
*.wav
*.ogg

# ML model weights
*.pt
*.pth
*.onnx
*.engine

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Local hardware configuration
hardware_config.local.py

# Secrets / credentials
credentials/
secrets/
*.pem
*.key

# Generated exports
exports/